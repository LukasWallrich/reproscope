<script>
(()=>{
const search=document.getElementById('quantity-search'),status=document.getElementById('quantity-status');
function filter(){let n=0;document.querySelectorAll('.quantity-record').forEach(r=>{const show=(!status.value||r.dataset.status===status.value)&&r.textContent.toLowerCase().includes(search.value.toLowerCase());r.hidden=!show;if(show)n++});document.getElementById('quantity-count').textContent=n+' quantities shown'}
if(search){search.addEventListener('input',filter);status.addEventListener('change',filter)}
function reveal(){if(location.hash.startsWith('#quantity-')){const r=document.getElementById(location.hash.slice(1));if(r){search.value='';status.value='';filter();r.open=true;r.scrollIntoView({block:'start'})}}}
window.addEventListener('hashchange',reveal);reveal();
const groups=JSON.parse(document.getElementById('multiverse-data').textContent);
const fmt=x=>x===null||x===undefined||x===''?'—':Math.abs(Number(x))>0&&Math.abs(Number(x))<.001?Number(x).toExponential(3):Number(x).toLocaleString('en-GB',{maximumFractionDigits:5});
const escape=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const names={estimate:'Estimate',n:'Participants',p_raw:'Raw p',p:'p used for comparison',ci_lower:'Interval lower bound',ci_upper:'Interval upper bound',ci_level:'Interval coverage',se:'Standard error',draws:'Permutation draws',exceedances:'Null exceedances',per_test_alpha:'Source per-test threshold'};
function selected(g,index){const r=g.rows[index],v=r.verification||{},checks=v.checks||[];const decision=r.p_adjustment==='fixed_threshold'?`Raw p = ${fmt(r.p_raw)}; source criterion = ${fmt(checks.find(c=>c.field==='per_test_alpha')?.reference)}. Its equivalent for comparison with .05 is ${fmt(r.p)}.`:`p used for comparison = ${fmt(r.p)}.`;return `<p><strong>Estimate ${fmt(r.estimate)}</strong>; ${r.ci_level?fmt(100*r.ci_level)+'% ':''}interval ${fmt(r.ci_lower)} to ${fmt(r.ci_upper)}. ${decision} n = ${fmt(r.n)}.</p><dl>${(r.choices||[]).map(c=>`<div><dt>${escape(c.factor)}</dt><dd>${escape(c.level)}</dd></div>`).join('')}</dl><details><summary>Independent numerical evidence: ${escape(v.status)}</summary><div class="inner"><p>The reference independently reads the deposit and implements the screened method. </p><ol>${(v.method_steps||[]).map(step=>`<li>${escape(step)}</li>`).join('')}</ol><div class="scroll"><table class="verification"><thead><tr><th>Component</th><th>Executor</th><th>Independent reference</th><th>Check</th></tr></thead><tbody>${checks.map(c=>`<tr><td>${escape(names[c.field]||c.field.replaceAll('_',' '))}</td><td>${fmt(c.observed)}</td><td>${fmt(c.reference)}</td><td>${escape(c.status)}</td></tr>`).join('')}</tbody></table></div><p class="footnote">Numerical tolerance for estimates and intervals: relative 10⁻⁷ and absolute 10⁻⁹. Probabilities use relative 10⁻⁷ and absolute 10⁻³⁰⁰, so tiny p-values cannot silently become zero. Counts and seeded exceedances must match exactly. Sample identities are compared privately. ${v.sample?`${fmt(v.sample.n)} retained; ${fmt(v.sample.scoring_exclusions)} excluded by scoring and ${fmt(v.sample.outlier_exclusions)} by the outlier rule.`:''}</p>${v.monte_carlo?`<p><b>Monte Carlo precision:</b> ${fmt(v.monte_carlo.exceedances)} exceedances in ${fmt(v.monte_carlo.draws)} draws; raw p resolution ${fmt(v.monte_carlo.resolution)}. The 95% binomial interval for the unadjusted tail probability is ${fmt(v.monte_carlo.raw_tail_interval[0])} to ${fmt(v.monte_carlo.raw_tail_interval[1])}. This describes simulation error, not uncertainty about the effect.</p>`:''}</div></details>`}
function highlight(i,index){const holder=document.getElementById('plot-'+i);holder.querySelectorAll('.spec-column').forEach(el=>{const active=Number(el.dataset.index)===index;el.classList.toggle('selected',active);el.setAttribute('aria-pressed',String(active));el.querySelector('.selection-column').setAttribute('opacity',active?'.07':'0');el.querySelector('.estimate-point').setAttribute('r',active?'6':'4')})}
groups.forEach((g,i)=>{const select=document.getElementById('select-'+i);if(!select)return;const render=()=>{const index=Number(select.value);document.querySelector('#detail-'+i+' .spec-content').innerHTML=selected(g,index);highlight(i,index)};select.addEventListener('change',render);document.querySelectorAll('#plot-'+i+' .spec-column').forEach(el=>{const choose=()=>{select.value=el.dataset.index;select.dispatchEvent(new Event('change'))};el.addEventListener('click',choose);el.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();choose()}})});document.getElementById('download-'+i)?.addEventListener('click',()=>{const svg=document.querySelector('#plot-'+i+' svg').cloneNode(true);svg.removeAttribute('style');const url=URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(svg)],{type:'image/svg+xml'}));const a=document.createElement('a');a.href=url;a.download='specification-curve-'+(i+1)+'.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)});render()});
})();
</script>
